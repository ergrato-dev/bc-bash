# TODO 3: con menos de 2 argumentos, el uso a stderr y código 2 (paso 4)

days="$1"
shift
# TODO 4: si "$days" no es un número entero de 1 o más, avisa en stderr y sale con 2 (paso 5)

# TODO 5: un for sobre "$@" que, si alguna carpeta no existe, avisa y sale con 1 (paso 6)

count=0
# TODO 6: un for sobre "$@" y, dentro, un while que lea con read -r -d '' lo que
#         encuentra find ... -print0 (paso 7)
